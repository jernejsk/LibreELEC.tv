     sl->redundant_pic_count = 0;
     if (pps->redundant_pic_cnt_present)
@@ -1810,9 +1812,11 @@ static int h264_slice_header_parse(const H264Context *h, H264SliceContext *sl,
 
     sl->explicit_ref_marking = 0;
     if (nal->ref_idc) {
