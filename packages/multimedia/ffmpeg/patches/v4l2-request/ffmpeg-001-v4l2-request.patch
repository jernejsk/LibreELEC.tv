 libavcodec/mpegpicture.c | 15 ++++-----------
 libavcodec/vp8.c         | 18 ++++++++----------
 libavcodec/vp9.c         | 18 +++++++-----------
 8 files changed, 62 insertions(+), 77 deletions(-)

diff --git a/libavcodec/av1dec.c b/libavcodec/av1dec.c
