From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Thu, 01 Oct 2026 12:58:21 +0200
Subject: [PATCH] drm/sun4i: Enable YUV 4:4:4 output on H6 and H616

Accept 8-bit and 10-bit YUV 4:4:4 on mixers with the formatter. Like
the vendor driver, pass YUV 4:4:4 through the formatter without
clamping, at the requested depth. dw-hdmi doesn't prefer YUV 4:4:4
over RGB on the link, but takes it as input when it outputs YUV 4:2:2,
which its CSC block decimates from 4:4:4, which is also how the vendor
driver drives YUV 4:2:2. The link then runs at a different rate than
the engine output suggests, so derive the TMDS clock from the dw-hdmi
output format. YUV 4:2:2 uses 12-bit containers at the pixel rate,
without the deep color factor.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/gpu/drm/sun4i/sun50i_fmt.c    |  8 +++++---
 drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c | 20 +++++++++++++++++---
 drivers/gpu/drm/sun4i/sun8i_mixer.c   |  4 +++-
 drivers/gpu/drm/sun4i/sunxi_engine.h  |  7 +++++--
 4 files changed, 30 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun50i_fmt.c b/drivers/gpu/drm/sun4i/sun50i_fmt.c
index b9d7a21e3705..f81e257f9c40 100644
--- a/drivers/gpu/drm/sun4i/sun50i_fmt.c
+++ b/drivers/gpu/drm/sun4i/sun50i_fmt.c
@@ -29,7 +29,8 @@ static u32 sun50i_fmt_get_colorspace(u32 format)
 static bool sun50i_fmt_is_10bit(u32 format)
 {
 	return format == MEDIA_BUS_FMT_UYYVYY10_0_5X30 ||
-	       format == MEDIA_BUS_FMT_RGB101010_1X30;
+	       format == MEDIA_BUS_FMT_RGB101010_1X30 ||
+	       format == MEDIA_BUS_FMT_YUV10_1X30;
 }
 
 void sun50i_fmt_setup(struct sun8i_mixer *mixer, u16 width,
@@ -47,7 +48,8 @@ void sun50i_fmt_setup(struct sun8i_mixer *mixer, u16 width,
 	sun8i_rdma_write(mixer->fmt_rdma, SUN50I_FMT_FORMAT, colorspace);
 	sun8i_rdma_write(mixer->fmt_rdma, SUN50I_FMT_COEF, 0);
 
-	if (!yuv) {
+	/* Like the vendor driver, only clamp when subsampling chroma. */
+	if (colorspace == SUN50I_FMT_CS_YUV444RGB) {
 		sun8i_rdma_write(mixer->fmt_rdma, SUN50I_FMT_LMT_Y,
 				 SUN50I_FMT_LIMIT_BYPASS);
 		sun8i_rdma_write(mixer->fmt_rdma, SUN50I_FMT_LMT_C0,
@@ -65,7 +67,7 @@ void sun50i_fmt_setup(struct sun8i_mixer *mixer, u16 width,
 
 	/*
 	 * 8-bit RGB bypasses the formatter, which keeps the upper 8 bits of
-	 * the 10-bit pipeline. Deep color RGB needs it for the 10-bit output.
+	 * the 10-bit pipeline. YUV and deep color output go through it.
 	 */
 	sun8i_rdma_write(mixer->fmt_rdma, SUN50I_FMT_CTRL, yuv || is_10bit);
 }
diff --git a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
index f765ae13139b..f0ad6b49ed53 100644
--- a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
+++ b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
@@ -166,14 +166,28 @@ sun8i_dw_hdmi_encoder_atomic_mode_set(struct drm_encoder *encoder,
 	struct sun8i_dw_hdmi *hdmi = encoder_to_sun8i_dw_hdmi(encoder);
 	struct drm_display_mode *mode = &crtc_state->adjusted_mode;
 	unsigned long rate = mode->crtc_clock * 1000UL;
+	struct drm_bridge_state *hdmi_state;
+	u32 format = scrtc_state->format;
+
+	/*
+	 * The rate depends on what goes over the link, which differs from
+	 * the engine output when dw-hdmi subsamples YUV 4:4:4 to 4:2:2.
+	 */
+	hdmi_state = drm_atomic_get_new_bridge_state(crtc_state->state,
+						     hdmi->next_bridge);
+	if (hdmi_state)
+		format = hdmi_state->output_bus_cfg.format;
 
 	/*
 	 * The TMDS character rate is derived from the pixel clock: deep
-	 * color multiplies it (10-bit: 5/4), and YUV 4:2:0 halves it
-	 * again since two horizontal samples share one TMDS period.
+	 * color multiplies it (10-bit: 5/4), except for YUV 4:2:2, which
+	 * always uses 12-bit containers at the pixel rate, and YUV 4:2:0
+	 * halves it again since two horizontal samples share one TMDS
+	 * period.
 	 */
-	switch (scrtc_state->format) {
+	switch (format) {
 	case MEDIA_BUS_FMT_RGB101010_1X30:
+	case MEDIA_BUS_FMT_YUV10_1X30:
 		rate = rate * 5 / 4;
 		break;
 	case MEDIA_BUS_FMT_UYYVYY10_0_5X30:
diff --git a/drivers/gpu/drm/sun4i/sun8i_mixer.c b/drivers/gpu/drm/sun4i/sun8i_mixer.c
index f2c2bef25f83..6e4d5b5e44b3 100644
--- a/drivers/gpu/drm/sun4i/sun8i_mixer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_mixer.c
@@ -505,7 +505,9 @@ static bool sun8i_mixer_format_valid(struct sunxi_engine *engine, u32 format)
 	if (mixer->cfg->has_formatter &&
 	    (format == MEDIA_BUS_FMT_UYYVYY8_0_5X24 ||
 	     format == MEDIA_BUS_FMT_UYYVYY10_0_5X30 ||
-	     format == MEDIA_BUS_FMT_RGB101010_1X30))
+	     format == MEDIA_BUS_FMT_RGB101010_1X30 ||
+	     format == MEDIA_BUS_FMT_YUV8_1X24 ||
+	     format == MEDIA_BUS_FMT_YUV10_1X30))
 		return true;
 
 	return format == MEDIA_BUS_FMT_RGB888_1X24;
diff --git a/drivers/gpu/drm/sun4i/sunxi_engine.h b/drivers/gpu/drm/sun4i/sunxi_engine.h
index 3e7bcb695e1b..45a4fe422aa6 100644
--- a/drivers/gpu/drm/sun4i/sunxi_engine.h
+++ b/drivers/gpu/drm/sun4i/sunxi_engine.h
@@ -300,11 +300,14 @@ sunxi_engine_format_valid(struct sunxi_engine *engine, u32 format)
  * sunxi_engine_format_is_yuv - Check if an output format is YUV
  * @format:	output media bus format
  *
- * Engines only ever output RGB or YUV 4:2:0, so anything else is RGB.
+ * Engines only ever output RGB, YUV 4:4:4 or YUV 4:2:0, so anything else
+ * is RGB.
  */
 static inline bool sunxi_engine_format_is_yuv(u32 format)
 {
-	return format == MEDIA_BUS_FMT_UYYVYY8_0_5X24 ||
+	return format == MEDIA_BUS_FMT_YUV8_1X24 ||
+	       format == MEDIA_BUS_FMT_YUV10_1X30 ||
+	       format == MEDIA_BUS_FMT_UYYVYY8_0_5X24 ||
 	       format == MEDIA_BUS_FMT_UYYVYY10_0_5X30;
 }
 #endif /* _SUNXI_ENGINE_H_ */
-- 
2.43.0

